# ===========================================
# SANATA CONSTRUCTION - Environment Template
# Copy ke .env dan isi dengan credentials yang benar
# ===========================================

# Environment
NODE_ENV=production
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/sanata

# JWT Secrets (generate dengan: openssl rand -base64 64)
JWT_ACCESS_SECRET=your-jwt-access-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-min-32-chars

# JWT Expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Client URL
CLIENT_URL=https://sanatagroup.id

# Upload Directory
UPLOAD_DIR=uploads

# Storage (local atau s3)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Redis (optional - untuk caching)
REDIS_URL=redis://127.0.0.1:6379

# SMTP Email (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Sanata Construction <no-reply@sanatagroup.id>
# INQUIRY_NOTIFY_TO=admin@sanatagroup.id

# Baileys WhatsApp Gateway (optional)
# BAILEYS_GATEWAY_URL=
# BAILEY_API_KEY=

# BluePack AI (optional - untuk chatbot)
# BLUEPACK_API_URL=https://ai.bluepack.my.id/v1
# BLUEPACK_API_KEY=
# BLUEPACK_MODEL=bluepack-coding
