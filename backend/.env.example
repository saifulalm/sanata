# Database — PostgreSQL 14+ (default instalasi: user postgres, port 5432).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Password dengan karakter khusus wajib di-URL-encode (@ menjadi %40, : menjadi %3A).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanata?schema=public"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5001"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-please"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Uploads
UPLOAD_DIR="uploads"

# Redis (optional — app runs without caching if unavailable)
REDIS_URL="redis://127.0.0.1:6379"

# Notifikasi email (opsional) — kosongkan untuk menonaktifkan.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sanata Construction <no-reply@sanata.id>"
INQUIRY_NOTIFY_TO=""

# Penyimpanan berkas: "local" (bawaan) atau "s3" untuk S3/Cloudflare R2.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_KEY_PREFIX=""

# Gateway WhatsApp berbasis Baileys. Diisi sekali di server; admin cukup
# memindai QR dari menu Broadcast tanpa menyentuh konfigurasi JSON.
BAILEYS_GATEWAY_URL=""
BAILEYS_API_KEY=""

# WhatsApp Baileys Gateway (Embedded)
# Direktori penyimpanan session WhatsApp
WHATSAPP_SESSIONS_DIR="./whatsapp-sessions"

# ============================================
# BluePack AI API - Blueprint Chatbot Widget
# ============================================
# BluePack menyediakan API OpenAI-compatible untuk AI chatbot
# Daftar di https://ai.bluepack.my.id untuk mendapatkan API key
# Format API key: bluepack_xxx

# Base URL API (default: https://ai.bluepack.my.id/v1)
BLUEPACK_API_URL="https://ai.bluepack.my.id/v1"

# API Key dari dashboard BluePack
BLUEPACK_API_KEY=""

# Model AI yang digunakan (default: bluepack-coding)
# Model lain yang tersedia tergantung paket langganan
BLUEPACK_MODEL="bluepack-coding"
